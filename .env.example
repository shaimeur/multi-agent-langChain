# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------------------
# Cache mode — decides whether anything touches the network.
#   replay   disk only. A missing fixture is an error. USE THIS FOR THE DEMO.
#   auto     read through: serve from disk, otherwise call the API and record.
#   refresh  always call the API and overwrite the recorded fixture.
# ---------------------------------------------------------------------------
CACHE_MODE=auto

# ---------------------------------------------------------------------------
# LLM provider — gemini | groq | ollama
#
# Default is gemini. All free Gemini models share a ~250k tokens/minute pool,
# roughly 20-40x Groq's 6-12k TPM. One FORGE change_request run is ~29 calls and
# ~300k input tokens, and a single Reviewer call carrying a 15-20k-token
# ContextPack exceeds Groq's per-minute budget on its own.
#
# Re-verify these quotas in the AI Studio dashboard the week of the demo:
# Google cut free-tier limits twice in under two months and no longer publishes
# a stable RPM/TPM table.
#
# Three roles, deliberately split so the token-fat models are used sparingly:
#   ROUTER    supervisor routing + guardrail classification -> cheap, high RPD
#   REASONER  Planner and Reviewer                          -> strong, low RPD
#   CODER     Editor and test generation                    -> strong code model
#
# Iterate on Flash-Lite during development and keep Flash in reserve for
# rehearsals and the defense itself.
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini

GOOGLE_API_KEY=
GEMINI_ROUTER_MODEL=gemini-2.5-flash-lite
GEMINI_REASONER_MODEL=gemini-2.5-flash
GEMINI_CODER_MODEL=gemini-2.5-flash

GROQ_API_KEY=
GROQ_ROUTER_MODEL=llama-3.3-70b-versatile
GROQ_REASONER_MODEL=llama-3.3-70b-versatile
GROQ_CODER_MODEL=llama-3.3-70b-versatile

# Offline profile. Run `ollama pull qwen2.5-coder:7b` well before the demo —
# it is a multi-GB download and this machine ships with mistral only.
#
# Scoped honestly: the local model serves the grounded-Q&A path (`forge ask`),
# NOT the full six-agent repair loop. A 7B does not hold up under the Planner
# and Reviewer prompts, and it would not fit in RAM beside Qdrant anyway.
# The record/replay fixtures are the real demo insurance — see §6 of
# docs/descope-v1.md.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_ROUTER_MODEL=qwen2.5-coder:7b
OLLAMA_REASONER_MODEL=qwen2.5-coder:7b
OLLAMA_CODER_MODEL=qwen2.5-coder:7b

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
# Measured on this CPU over 345 chunks: this model 47 ms/chunk, BAAI/bge-m3
# 1709 ms/chunk — 36x. Chosen on throughput alone; D4's ablation compares recall
# and may reverse it. `hashing` selects a no-model stub used by the test suite.
# See docs/evaluation.md.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Server mode under compose. Leave blank to use embedded Qdrant instead, which
# drops a container and frees ~300 MB-1 GB — the escape hatch if RAM gets tight.
QDRANT_URL=http://localhost:6333
QDRANT_PATH=data/qdrant
RETRIEVAL_TOP_K=8
# Reranking is built and measured in the eval harness but OFF in the live path:
# a cross-encoder over the fused top-k costs hundreds of ms per query with no
# GPU. The ablation table reports exactly what that costs us.
RERANK_ENABLED=false

# ---------------------------------------------------------------------------
# Workspace — the repository FORGE operates on
# ---------------------------------------------------------------------------
# Pick one at the bottom of the cahier's 5k-20k LOC range, pure Python, and it
# MUST ship a real pytest suite: the Sandbox Engineer extends an existing suite,
# and without one the red -> green demo has nothing to stand on.
TARGET_REPO=data/target
WORKSPACE_ROOT=data/workspaces
CHECKPOINT_DB=data/checkpoints.sqlite

# ---------------------------------------------------------------------------
# Sandbox hardening (cahier 8.3) — these numbers are quoted on the security
# slide, so tests assert them. Change both together or the slide becomes false.
# ---------------------------------------------------------------------------
SANDBOX_IMAGE=forge-sandbox:latest
SANDBOX_TIMEOUT_S=60
SANDBOX_MEMORY_MB=512
SANDBOX_CPUS=1.0
SANDBOX_PIDS_LIMIT=128
SANDBOX_MAX_OUTPUT_BYTES=64000

# ---------------------------------------------------------------------------
# Budget guard — the Supervisor aborts with a partial answer past these.
# ---------------------------------------------------------------------------
MAX_ITERATIONS_PER_STEP=3
MAX_LLM_CALLS_PER_RUN=40
MAX_TOKENS_PER_RUN=400000
MAX_WALL_CLOCK_S=900
