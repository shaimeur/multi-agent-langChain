.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Claude Code continuity: hooks, settings and commands are committed; the
# pre-compact transcript archive is local session state and is not.
.claude/transcripts/

# Secrets — never commit
.env
.env.local

# Local state
data/qdrant/
data/workspaces/
data/target/

# The same state, but stray. The rules above are anchored at the repo root, so a
# `forge` run from a subdirectory with a relative QDRANT_PATH lands an empty
# embedded index somewhere git still tracks (web/data/qdrant/ is the one that
# actually happened). It is never worth committing, wherever it lands.
**/data/qdrant/
**/data/workspaces/
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db

# IMPORTANT: data/fixtures/ is deliberately NOT ignored.
# The recorded API/LLM responses are what make the offline demo reproducible on
# a fresh clone with no API keys. They are scrubbed of secrets on write — see
# src/forge/cache/fixtures.py.

# Index manifests: machine-local state (absolute paths, BM25 corpus statistics,
# the sha last indexed). Rebuilt by `forge index`, never shared.
data/*-index-manifest.json

# Ablation output: regenerated by `evals/run_ablation.py`; latency fields churn
# every run. The curated numbers live in docs/evaluation.md and the charts are
# baked into notebooks/01_rag_evaluation.ipynb.
evals/results/

# D15b — a throwaway second repo so the UI target picker has two options.
data/demo-notes/
