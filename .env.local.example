# FORGE — local runnable profile. No cloud API key, no containers.
#
#   cp .env.local.example .env
#
# Answers `forge ask` / POST /v1/ask with the Ollama model already on this
# machine (mistral:latest) and serves retrieval from the embedded Qdrant index
# under data/qdrant. Everything not set here falls back to the code defaults
# (MiniLM embedder, data/target, sandbox caps). To use a hosted model instead,
# set LLM_PROVIDER=gemini and GOOGLE_API_KEY in your real .env.

LLM_PROVIDER=ollama
OLLAMA_ROUTER_MODEL=mistral:latest
OLLAMA_REASONER_MODEL=mistral:latest
OLLAMA_CODER_MODEL=mistral:latest

# Embedded Qdrant (no server container). Blank is the escape hatch from ADR-002.
QDRANT_URL=

# auto: call the LLM for real and record it to the fixture cache; flip to
# `replay` once recorded for a fully offline demo.
CACHE_MODE=auto
